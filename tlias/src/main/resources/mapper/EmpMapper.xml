<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.itheima.mapper.EmpMapper">

    <resultMap id="EmpResultMap" type="com.itheima.pojo.Emp">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="password" property="password"/>
        <result column="name" property="name"/>
        <result column="gender" property="gender"/>
        <result column="phone" property="phone"/>
        <result column="image" property="image"/>
        <result column="job" property="job"/>
        <result column="salary" property="salary"/>
        <result column="entry_date" property="entryDate"/>
        <result column="dept_id" property="deptId"/>
        <result column="dept_name" property="deptName"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 一对多结果映射：查询回显时把工作经历封装进 exprList（collection） -->
    <resultMap id="EmpDetailResultMap" type="com.itheima.pojo.Emp">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="password" property="password"/>
        <result column="name" property="name"/>
        <result column="gender" property="gender"/>
        <result column="phone" property="phone"/>
        <result column="image" property="image"/>
        <result column="job" property="job"/>
        <result column="salary" property="salary"/>
        <result column="entry_date" property="entryDate"/>
        <result column="dept_id" property="deptId"/>
        <result column="dept_name" property="deptName"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <collection property="exprList" ofType="com.itheima.pojo.EmpExpr">
            <id column="ee_id" property="id"/>
            <result column="ee_empid" property="empId"/>
            <result column="ee_company" property="company"/>
            <result column="ee_job" property="job"/>
            <result column="ee_begin" property="begin"/>
            <result column="ee_end" property="end"/>
        </collection>
    </resultMap>

    <sql id="Base_Column_List">
        e.id, e.username, e.password, e.name, e.gender, e.phone, e.image, e.job, e.salary,
        e.entry_date, e.dept_id, d.name as dept_name, e.create_time, e.update_time
    </sql>

    <select id="selectPage" resultMap="EmpResultMap">
        select
        <include refid="Base_Column_List"/>
        from emp e left join dept d on e.dept_id = d.id
        <where>
            <if test="name != null and name != ''">
                e.name like concat('%', #{name}, '%')
            </if>
            <if test="gender != null">
                and e.gender = #{gender}
            </if>
            <if test="begin != null and end != null">
                and e.entry_date between #{begin} and #{end}
            </if>
        </where>
        order by e.update_time desc
        limit #{offset}, #{pageSize}
    </select>

    <select id="count" resultType="java.lang.Long">
        select count(*) from emp e
        <where>
            <if test="name != null and name != ''">
                e.name like concat('%', #{name}, '%')
            </if>
            <if test="gender != null">
                and e.gender = #{gender}
            </if>
            <if test="begin != null and end != null">
                and e.entry_date between #{begin} and #{end}
            </if>
        </where>
    </select>

    <insert id="insertExprBatch">
        insert into emp_expr(emp_id, company, job, begin, end) values
        <foreach collection="list" item="item" separator=",">
            (#{empId}, #{item.company}, #{item.job}, #{item.begin}, #{item.end})
        </foreach>
    </insert>

    <delete id="deleteByIds">
        delete from emp where id in
        <foreach collection="ids" item="id" open="(" close=")" separator=",">
            #{id}
        </foreach>
    </delete>

    <delete id="deleteExprByEmpIds">
        delete from emp_expr where emp_id in
        <foreach collection="ids" item="id" open="(" close=")" separator=",">
            #{id}
        </foreach>
    </delete>

    <!-- 根据ID查询员工的详细信息（含工作经历，一条 left join 语句） -->
    <select id="getById" resultMap="EmpDetailResultMap">
        select e.*, d.name as dept_name,
        ee.id ee_id, ee.emp_id ee_empid, ee.company ee_company,
        ee.job ee_job, ee.begin ee_begin, ee.end ee_end
        from emp e
        left join dept d on e.dept_id = d.id
        left join emp_expr ee on e.id = ee.emp_id
        where e.id = #{id}
    </select>

    <select id="selectExprByEmpId" resultType="com.itheima.pojo.EmpExpr">
        select id, emp_id, company, job, begin, end
        from emp_expr where emp_id = #{empId} order by begin
    </select>

    <update id="update">
        update emp
        <set>
            <if test="username != null and username != ''">username = #{username},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="gender != null">gender = #{gender},</if>
            <if test="phone != null and phone != ''">phone = #{phone},</if>
            <if test="image != null and image != ''">image = #{image},</if>
            <if test="job != null">job = #{job},</if>
            <if test="salary != null">salary = #{salary},</if>
            <if test="entryDate != null">entry_date = #{entryDate},</if>
            <if test="deptId != null">dept_id = #{deptId},</if>
            update_time = #{updateTime}
        </set>
        where id = #{id}
    </update>

    <update id="updateExprBatch">
        <foreach collection="list" item="item">
            update emp_expr set company = #{item.company}, job = #{item.job},
            begin = #{item.begin}, end = #{item.end} where id = #{item.id};
        </foreach>
    </update>

    <delete id="deleteExprByEmpId">
        delete from emp_expr where emp_id = #{empId}
    </delete>

</mapper>
